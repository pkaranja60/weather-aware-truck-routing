# Backend Environment Variables (backend/.env)
SECRET_KEY=replace-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-truck-router.vercel.app
# Local PostgreSQL:
DATABASE_URL=postgres://postgres:<your_password>@localhost:5432/weather-aware
# Leave empty to default to SQLite (db.sqlite3):
# DATABASE_URL=
NOMINATIM_USER_AGENT=SpotterRouteApp/1.0

# Frontend Environment Variables (frontend/.env)
VITE_API_URL=http://localhost:8000/api
# For Vercel production deployment:
# VITE_API_URL=https://spotter-backend.onrender.com/api
